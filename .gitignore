# ==============================================================================
# .gitignore - Hiver Support Agent
# ==============================================================================

# --- Python Bytecode & Optimization ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Distribution & Packaging ---
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Environments & Secrets ---
.env
.env.*
*.env
*.pem
*.key
*.credentials
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
.python-version

# --- Testing, Coverage & Profiling ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.hypothesis/
.tox/
.nox/
*.lprof

# --- Type Checking & Linting ---
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*-checkpoint.ipynb

# --- Streamlit & Web Frameworks ---
.streamlit/secrets.toml
.streamlit/*.local.toml

# --- Large Datasets & Archives ---
# twcs.csv is ~516MB (exceeds GitHub's 100MB file limit)
data/*.csv
data/**/*.csv
data/processed/*.jsonl
data/**/*.jsonl
*.parquet
*.feather
*.h5
*.hdf5
*.tar
*.tar.gz
*.zip
*.7z
*.rar

# --- Whitelist Golden Sets, Guides & Preserved Metadata ---
!data/**/.gitkeep
!data/processed/*.md
!data/**/README.md
!data/processed/taxonomy_spotcheck.csv
!data/golden/**
data/golden/_*
data/golden/.*
!data/index/*.md
!data/index/**/.gitkeep
!data/results/**/.gitkeep

# --- FAISS Retrieval Index & Chunks ---
data/index/*.faiss
data/index/*.index
data/index/*.bin
data/index/*.npy
data/index/*.npz
data/index/*.pkl
data/index/.chunks/
data/index/*.jsonl

# --- Model Weights & HuggingFace Caches ---
models/
.cache/
huggingface/
*.safetensors
*.pt
*.pth
*.onnx
*.tflite

# --- Scratchpads, Working Scripts & Temporary Files ---
scratch/
**/scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# --- Logging ---
*.log
logs/

# --- IDEs & Editors ---
.vscode/
.idea/
.cursor/
.windsurf/
.zed/
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- Agent / AI Tool Metadata ---
.gemini/
.agents/
